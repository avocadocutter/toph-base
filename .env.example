# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=toph
POSTGRES_USER=toph_admin
POSTGRES_PASSWORD=changeme

# Authentication
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Admin
ADMIN_EMAIL=admin@toph.local
ADMIN_PASSWORD=changeme

# Gateway
GATEWAY_PORT=8000
DASHBOARD_PORT=3000
LOG_LEVEL=info

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100

# Features
ENABLE_SIGNUP=true
REQUIRE_AUTH_FOR_API=true
