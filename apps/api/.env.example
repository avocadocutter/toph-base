# Template for ~/.secrets/toph-base.env
# Copy this file: cp apps/api/.env.example ~/.secrets/toph-base.env
# Then fill in the required values marked below.
# Do NOT copy this into the repo as a .env file — secrets live outside the repo.

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=toph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Configuration
# REQUIRED — app will not start without this. Generate with: openssl rand -hex 32
JWT_PLATFORM_SECRET=change-this-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Admin User (created on first boot)
ADMIN_EMAIL=admin@toph.local
# REQUIRED — app will not start without this
ADMIN_PASSWORD=changeme

# Server Configuration
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=info

# Dashboard port (used by the Vite dev server — must match CORS_ALLOWED_ORIGINS below)
DASHBOARD_PORT=3000

# CORS — set to the dashboard origin, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100

# Features
ENABLE_SIGNUP=true
REQUIRE_AUTH_FOR_API=true

# Public API URL Configuration
# =============================
# This is the base domain for your API, used to generate project-specific URLs.
# Similar to Supabase's PUBLIC_SUPABASE_URL format.
#
# Format: https://{project-ref}.{PUBLIC_API_URL}/rest/v1
#
# Examples:
#   - Production: https://api.yourdomain.com
#     → Project URLs: https://{ref}.api.yourdomain.com/rest/v1
#
#   - Local dev: http://localhost:8000
#     → Project URLs: http://{ref}.localhost:8000/rest/v1
#
#   - Custom domain: https://yourdomain.com
#     → Project URLs: https://{ref}.yourdomain.com/rest/v1
#
# IMPORTANT: Requires wildcard DNS configuration (*.yourdomain.com)
# pointing to your server. For local development, *.localhost works
# automatically in most browsers.
#
# If not set, defaults to the current request host.
PUBLIC_API_URL=http://localhost:8000
