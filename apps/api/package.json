{
  "name": "tophbase",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "tophbase": "./dist/cli/tophbase.js"
  },
  "files": [
    "dist",
    "dashboard"
  ],
  "scripts": {
    "dev": "nodemon --exec 'tsx src/index.ts' --ext ts,json --ignore dist",
    "dev:env": "nodemon --exec 'dotenvx run -f .env.tophbase -- tsx src/index.ts' --ext ts,json --ignore dist",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:env": "dotenvx run -f .env.tophbase -- node dist/index.js",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "format": "prettier --write src/ --config ../../prettier.config.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.0",
    "argon2": "^0.41.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "~8.x",
    "@typescript-eslint/parser": "~8.x",
    "eslint": "~9.x",
    "nodemon": "^3.1.14",
    "prettier": "~3.x",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
