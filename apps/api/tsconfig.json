{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/db/pool-manager.ts",
    "src/hooks/resolve-project-from-apikey.ts",
    "src/plugins/admin/index.ts",
    "src/plugins/api-keys/index.ts",
    "src/plugins/auth/platform-handlers.ts",
    "src/plugins/projects/index.ts",
    "src/hooks/authenticate.test.ts",
    "src/plugins/auth/jwt.test.ts"
  ]
}
