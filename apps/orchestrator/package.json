{
  "name": "tophbase",
  "version": "0.1.5",
  "description": "Local Supabase-compatible backend — no Docker, no cloud account. One command to start.",
  "license": "MIT",
  "keywords": [
    "supabase",
    "pglite",
    "postgres",
    "local",
    "backend",
    "cli",
    "fastify",
    "auth",
    "storage",
    "railway"
  ],
  "homepage": "https://github.com/avocadocutter/toph-base",
  "repository": {
    "type": "git",
    "url": "https://github.com/avocadocutter/toph-base.git"
  },
  "author": "avocadocutter",
  "type": "module",
  "bin": {
    "tophbase": "./dist/cli/tophbase.js"
  },
  "files": [
    "dist",
    "dashboard"
  ],
  "scripts": {
    "dev": "tsx src/cli/tophbase.ts freshman",
    "build": "tsc",
    "prepack": "cp ../../README.md ./README.md",
    "clean": "rm -rf dist",
    "format": "prettier --write src/ --config ../../prettier.config.mjs"
  },
  "dependencies": {
    "@tophbase/api": "workspace:*",
    "@electric-sql/pglite-socket": "^0.1.5",
    "@fastify/static": "^8.1.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "prettier": "~3.x",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
