# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=toph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Configuration
JWT_PLATFORM_SECRET=change-this-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Admin User (created on first boot)
ADMIN_EMAIL=admin@toph.local
ADMIN_PASSWORD=changeme

# Server Configuration
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100

# Features
ENABLE_SIGNUP=true
REQUIRE_AUTH_FOR_API=true

# PostgREST Health Checks
POSTGREST_HEALTH_CHECK_INTERVAL_MS=30000
POSTGREST_HEALTH_CHECK_TIMEOUT_MS=5000

# Public API URL Configuration
# =============================
# This is the base domain for your API, used to generate project-specific URLs.
# Similar to Supabase's PUBLIC_SUPABASE_URL format.
#
# Format: https://{project-ref}.{PUBLIC_API_URL}/rest/v1
#
# Examples:
#   - Production: https://api.yourdomain.com
#     → Project URLs: https://{ref}.api.yourdomain.com/rest/v1
#
#   - Local dev: http://localhost:8000
#     → Project URLs: http://{ref}.localhost:8000/rest/v1
#
#   - Custom domain: https://yourdomain.com
#     → Project URLs: https://{ref}.yourdomain.com/rest/v1
#
# IMPORTANT: Requires wildcard DNS configuration (*.yourdomain.com)
# pointing to your server. For local development, *.localhost works
# automatically in most browsers.
#
# If not set, defaults to the current request host.
PUBLIC_API_URL=http://localhost:8000
